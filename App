# app.py
import io
import json
import numpy as np
from PIL import Image
from pathlib import Path
import torch
import torch.nn as nn
import torchvision.transforms as T
import torchvision
from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.responses import JSONResponse
from ultralytics import YOLO

# --------- Config (edit paths if needed) ----------
YOLO_MODEL = "yolov8n.pt"                  # or path to your YOLO weights
MLP_MODEL = "models/mlp.pth"               # trained MLP weights
SCALER_JSON = "models/scaler.json"         # saved mean/std (optional)
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
# --------------------------------------------------

app = FastAPI(title="Chicken Weight Predictor (single image)")

# MLP definition must match training
class MLP(nn.Module):
    def __init__(self, in_dim=512):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, 256),
            nn.ReLU(),
            nn.Linear(256, 128),
            nn.ReLU(),
            nn.Linear(128, 1)
        )
    def forward(self,x):
        return self.net(x).squeeze(1)

# Load YOLO model (Ultralytics)
try:
    yolo = YOLO(YOLO_MODEL)
except Exception as e:
    yolo = None
    print("Warning: YOLO model not loaded:", e)

# Load ResNet backbone (same as feature extractor)
resnet = torchvision.models.resnet18(pretrained=True)
modules = list(resnet.children())[:-1]  # remove fc
backbone = torch.nn.Sequential(*modules).to(DEVICE)
backbone.eval()

# Preprocessing transform (same as used during feature extraction)
tf = T.Compose([
    T.Resize((224,224)),
    T.ToTensor(),
    T.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])
])

# Load MLP
if not Path(MLP_MODEL).exists():
    raise FileNotFoundError(f"MLP model not found: {MLP_MODEL}")
# instantiate MLP after knowing feature dim (512)
mlp = MLP(in_dim=512)
mlp.load_state_dict(torch.load(MLP_MODEL, map_location="cpu"))
mlp.to(DEVICE)
mlp.eval()

# Load scaler if available (expects json with "mean" and "std")
scaler = None
if Path(SCALER_JSON).exists():
    with open(SCALER_JSON, "r") as f:
        j = json.load(f)
        # expecting {"mean": [...], "std": [...]}
        if "mean" in j and "std" in j:
            mean_vec = np.array(j["mean"], dtype=np.float32)
            std_vec = np.array(j["std"], dtype=np.float32)
            scaler = {"mean": mean_vec, "std": std_vec}
        else:
            print("scaler json does not contain mean/std keys; ignoring scaler")
else:
    print("No scaler.json found; predictions will be made without scaling (not recommended)")

def pil_crop_from_xyxy(img: Image.Image, xyxy):
    """Crop a PIL image using integer xyxy tuple (x1,y1,x2,y2)"""
    x1,y1,x2,y2 = map(int, xyxy)
    # guard bounds
    x1 = max(0, x1); y1 = max(0, y1)
    x2 = min(img.width, x2); y2 = min(img.height, y2)
    if x2 <= x1 or y2 <= y1:
        return img
    return img.crop((x1,y1,x2,y2))

def extract_feature_from_pil(img_pil: Image.Image):
    """Return numpy (512,) feature vector from a PIL image."""
    x = tf(img_pil).unsqueeze(0).to(DEVICE)  # 1x3x224x224
    with torch.no_grad():
        feat = backbone(x)  # 1x512x1x1
        feat = feat.squeeze().cpu().numpy().reshape(-1)  # (512,)
    return feat

@app.post("/predict", summary="Upload single image file and get predicted weight (grams)")
async def predict(file: UploadFile = File(...)):
    # Read
    contents = await file.read()
    try:
        img = Image.open(io.BytesIO(contents)).convert("RGB")
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Cannot open image: {e}")

    # 1) run detection if YOLO exists
    crop_img = img
    if yolo is not None:
        try:
            results = yolo.predict(source=io.BytesIO(contents), imgsz=640, device=DEVICE.type, verbose=False)
            # use the first result (single image)
            if len(results) > 0:
                r = results[0]
                boxes = r.boxes
                if boxes is not None and len(boxes) > 0:
                    # take first box xyxy
                    xyxy = boxes.xyxy[0].cpu().numpy().tolist()  # [x1,y1,x2,y2,conf,class]
                    # boxes.xyxy yields shape Nx5 or Nx6 depending; keep first 4
                    crop_xy = xyxy[:4]
                    crop_img = pil_crop_from_xyxy(img, crop_xy)
                else:
                    # no detection -> use whole image
                    crop_img = img
        except Exception as e:
            # detection failed; fallback to using whole image
            print("YOLO detect failed:", e)
            crop_img = img

    # 2) extract features
    feat = extract_feature_from_pil(crop_img)  # numpy (512,)

    # 3) scale if scaler present
    if scaler is not None:
        feat_scaled = (feat - scaler["mean"]) / (scaler["std"] + 1e-12)
    else:
        feat_scaled = feat

    # 4) predict via MLP
    x = torch.tensor(feat_scaled, dtype=torch.float32).unsqueeze(0).to(DEVICE)
    with torch.no_grad():
        out = mlp(x).cpu().numpy().item()

    # **Return predicted grams (float)**
    return JSONResponse({"pred_g": float(out)})

# health endpoint
@app.get("/")
def root():
    return {"status": "ok", "device": str(DEVICE)}
