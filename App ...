# app.py
import io
import json
from typing import Tuple, List, Optional

from fastapi import FastAPI, File, UploadFile, HTTPException
from fastapi.responses import JSONResponse
from PIL import Image
import numpy as np
import torch
import torchvision.transforms as T
import torchvision
from pathlib import Path

# YOLO (ultralytics)
try:
    from ultralytics import YOLO
except Exception:
    YOLO = None

app = FastAPI(title="Chicken weight predictor (grams)")

# ---- Config: change these paths if needed ----
YOLO_WEIGHTS = "runs/detect/train/weights/best.pt"   # or "yolov8n.pt" if you want general detector
MLP_WEIGHTS = "models/mlp.pth"
SCALER_JSON = "models/scaler.json"
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
# ----------------------------------------------

# MLP must match train_mlp.MLP
import torch.nn as nn
class MLP(nn.Module):
    def __init__(self, in_dim=512):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, 256),
            nn.ReLU(),
            nn.Linear(256,128),
            nn.ReLU(),
            nn.Linear(128,1)
        )
    def forward(self,x):
        return self.net(x).squeeze(1)

# Load backbone (ResNet18 without final FC) — same as extract_features.py
def load_backbone(device):
    resnet = torchvision.models.resnet18(weights=None)  # weights=None avoids downloads in older torchvision
    # If you trained with pretrained=True, but inference used pretrained resnet; it's okay as feature extractor.
    # Remove final FC
    modules = list(resnet.children())[:-1]
    backbone = torch.nn.Sequential(*modules).to(device).eval()
    return backbone

# Preprocess transforms used when extracting features
_tf = T.Compose([
    T.Resize((224,224)),
    T.ToTensor(),
    T.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])
])

# Load scaler (expects JSON with 'mean' and 'std' arrays)
def load_scaler(path: str):
    if not Path(path).exists():
        return None
    with open(path, "r") as f:
        data = json.load(f)
    mean = np.array(data.get("mean", []), dtype=float) if "mean" in data else None
    std  = np.array(data.get("std", []), dtype=float) if "std" in data else None
    if mean is None or std is None or len(mean)==0 or len(std)==0:
        return None
    return (mean, std)

# Load MLP model (infer in CPU if server runs CPU)
def load_mlp_model(path: str, in_dim=512, device=DEVICE):
    model = MLP(in_dim=in_dim).to(device)
    state = torch.load(path, map_location=device)
    model.load_state_dict(state)
    model.eval()
    return model

# Load YOLO
def load_yolo(path: str):
    if YOLO is None:
        raise RuntimeError("ultralytics is not installed (pip install ultralytics)")
    return YOLO(path)

# Utility: run YOLO detect on PIL image and return first bbox (x1,y1,x2,y2) or None
def yolo_detect_first_box(yolo_model, pil_img: Image.Image) -> Optional[Tuple[int,int,int,int]]:
    # the YOLO predict API accepts numpy arrays or PIL images
    results = yolo_model(pil_img, imgsz=640, conf=0.25)  # returns list-like; use defaults
    if len(results) == 0:
        return None
    r = results[0]
    # r.boxes.xyxy exists in ultralytics result
    try:
        boxes = r.boxes.xyxy.cpu().numpy()  # shape (N,4)
    except Exception:
        # fallback: no boxes
        return None
    if boxes.shape[0] == 0:
        return None
    x1,y1,x2,y2 = boxes[0].astype(int).tolist()
    return (int(x1), int(y1), int(x2), int(y2))

# Extract 512-d feature from cropped PIL image using backbone
def extract_features_from_crop(backbone, pil_crop: Image.Image, device=DEVICE) -> np.ndarray:
    x = _tf(pil_crop).unsqueeze(0).to(device)  # 1 x 3 x 224 x 224
    with torch.no_grad():
        feat = backbone(x)            # shape 1 x 512 x 1 x 1
        feat = feat.squeeze().cpu().numpy().reshape(-1)  # (512,)
    return feat

# Scale features: (feat - mean) / std
def scale_feat(feat: np.ndarray, scaler) -> np.ndarray:
    if scaler is None:
        return feat
    mean, std = scaler
    return (feat - mean) / std

# init models on startup
@app.on_event("startup")
def startup_event():
    global YOLO_MODEL, BACKBONE, MLP_MODEL, SCALER
    # load YOLO if file exists, else keep None
    try:
        YOLO_MODEL = load_yolo(YOLO_WEIGHTS) if Path(YOLO_WEIGHTS).exists() else load_yolo("yolov8n.pt")
    except Exception as e:
        YOLO_MODEL = None
        print("Warning: YOLO not loaded:", e)
    BACKBONE = load_backbone(DEVICE)
    SCALER = load_scaler(SCALER_JSON)
    # check feature dim: run a dummy input through backbone to know in_dim
    dummy = torch.randn(1,3,224,224).to(DEVICE)
    with torch.no_grad():
        out = BACKBONE(dummy).squeeze().cpu().numpy().reshape(-1)
    in_dim = out.shape[0]
    # load MLP
    if not Path(MLP_WEIGHTS).exists():
        raise RuntimeError(f"MLP weights not found at {MLP_WEIGHTS}")
    MLP_MODEL = load_mlp_model(MLP_WEIGHTS, in_dim=in_dim, device=DEVICE)
    print("Startup complete. Device:", DEVICE, "Scaler loaded:", SCALER is not None)

# Prediction endpoint: accept a single image file
@app.post("/predict")
async def predict(file: UploadFile = File(...)):
    # read bytes into PIL
    contents = await file.read()
    try:
        img = Image.open(io.BytesIO(contents)).convert("RGB")
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Could not open image: {e}")

    # run YOLO detection
    if YOLO_MODEL is None:
        raise HTTPException(status_code=500, detail="YOLO model not loaded on server.")
    bbox = yolo_detect_first_box(YOLO_MODEL, img)
    if bbox is None:
        # return zero or helpful message
        return JSONResponse({"pred_g": None, "bbox": None, "error": "No chicken detected"})

    x1,y1,x2,y2 = bbox
    # crop (be careful with bounds)
    w,h = img.size
    x1 = max(0, min(x1, w-1)); y1 = max(0, min(y1, h-1))
    x2 = max(0, min(x2, w-1)); y2 = max(0, min(y2, h-1))
    crop = img.crop((x1,y1,x2,y2))

    # extract features, scale and predict
    feat = extract_features_from_crop(BACKBONE, crop, device=DEVICE)
    feat_scaled = scale_feat(feat, SCALER)
    x_tensor = torch.tensor(feat_scaled, dtype=torch.float32, device=DEVICE).unsqueeze(0)  # 1 x D
    with torch.no_grad():
        pred = MLP_MODEL(x_tensor).cpu().numpy().item()

    # pred is in same units as weights.csv (grams)
    # ensure float not numpy types
    out = float(pred)
    return JSONResponse({"pred_g": out, "bbox": [int(x1),int(y1),int(x2),int(y2)]})
